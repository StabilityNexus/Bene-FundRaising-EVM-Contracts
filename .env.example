# Copy to .env and fill in. Never commit .env.

# Private key of the account that deploys to live networks (required for them).
# yarn generate creates a random one for you.
DEPLOYER_PRIVATE_KEY=

# Etherscan API key, only needed to verify contracts.
ETHERSCAN_API_KEY=

# Optional: fork a network for local testing.
FORKING_URL=
MAINNET_FORKING_ENABLED=false
